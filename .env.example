# .env.example - Credentials and configuration template for SIH26071 REWS
# Copy to .env and populate with your credentials. NEVER commit .env to version control.

# --- NASA Earthdata (Required for GPM IMERG and Sentinel-1 via ASF DAAC) ---
# Register free at: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# --- ECMWF Climate Data Store (Required for ERA5 reanalysis) ---
# Register at: https://cds.climate.copernicus.eu/
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your_cdsapi_personal_access_token

# --- ISRO MOSDAC (Optional: automated query for INSAT-3D/3DR imagery) ---
# Register at: https://www.mosdac.gov.in/
# Note: If not using API, place .h5 files directly in data/raw/insat/
MOSDAC_USERNAME=your_mosdac_username
MOSDAC_PASSWORD=your_mosdac_password

# --- Telegram Alert Bot (Optional for Stage 7 live dispatch) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Local Directories (Overrides default configs if set) ---
REWS_DATA_RAW=data/raw
REWS_DATA_PROCESSED=data/processed
REWS_OUTPUTS=outputs
